# Salesforce AI Assistant Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Salesforce Configuration (Required for live mode)
SF_USERNAME=your_salesforce_username@company.com
SF_PASSWORD=your_salesforce_password
SF_TOKEN=your_salesforce_security_token

# Test Mode Configuration
# Set to "true" to use mock data instead of real Salesforce API calls
# Set to "false" to use real Salesforce data
USE_MOCK_DATA=true

# LangChain Configuration (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# SSL Configuration (Development only)
PYTHONHTTPSVERIFY=0

# Example values for testing:
# USE_MOCK_DATA=true    # Safe testing without API calls
# USE_MOCK_DATA=false   # Live Salesforce integration